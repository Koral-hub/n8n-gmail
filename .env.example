# Skopiuj jako .env (w tym samym folderze co docker-compose.yml) i uzupełnij.
# Docker Compose wczytuje .env automatycznie. Nie commituj .env do Gita.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=zmien-haslo
POSTGRES_DB=n8n

# Wygeneruj raz i NIE zmieniaj po pierwszym starcie:
#   Linux/macOS/Git Bash:  openssl rand -hex 32
#   PowerShell:            -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
N8N_ENCRYPTION_KEY=

# Klucze do LLM-ów NIE idą tutaj. Wpisujesz je w n8n: Credentials -> Create credential.
